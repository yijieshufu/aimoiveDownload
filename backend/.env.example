# 复制为 backend/.env 或项目根 .env 后按需填写（FastAPI 启动前由 shell 导出亦可）
# 启动时 backend/main 会加载：项目根/.env 与 backend/.env（不覆盖已在 shell 中 export 的变量）

# 生产环境务必设置其一，否则未登录仍可使用匿名 AI 总结（仅受 IP 日限额）：
# ENVIRONMENT=production
# 或显式关闭：DEV_ALLOW_ANONYMOUS_AI=0

# 可选：强制开启（未配置时本地默认已允许匿名总结，仅当上面 production 时关闭）
# DEV_ALLOW_ANONYMOUS_AI=1
# 开发匿名总结的每日上限（默认 50）
# DEV_ANON_SUMMARIZE_DAILY=50

# 解析 / 下载日额度：非生产环境默认不限制、不计次（无需登录即可一直解析下载）。
# 生产环境请设置 ENVIRONMENT=production，将恢复匿名与免费用户的日上限。
# 若要在本地模拟额度策略，可强制开启统计与上限：
# DEV_BYPASS_EXTRACT_DOWNLOAD=0

# SQLite 数据库文件路径（默认 backend/data/app.db）
# DATABASE_PATH=

# 总结 / LLM（至少配置其一）
# DEEPSEEK_API_KEY=
# SUMMARY_API_KEY=
# SUMMARY_PROVIDER=openai
# SUMMARY_BASE_URL=
# SUMMARY_MODEL=
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=

# Whisper 本地转写（可选）
# WHISPER_MODEL_SIZE=tiny
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=auto

# 会话 Cookie 签名（生产环境务必修改）
# AUTH_SECRET_KEY=

# 公网回调基址（OAuth 等）
# PUBLIC_BASE_URL=https://your-domain.com

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 微信开放平台（网站应用扫码登录）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# 微信支付 v3（下单骨架用）
# WECHATPAY_MCHID=
# WECHATPAY_SERIAL_NO=
# WECHATPAY_PRIVATE_KEY_PEM=
# WECHATPAY_API_V3_KEY=
# WECHATPAY_APP_ID=

# 支付宝
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY_PEM=
# ALIPAY_PUBLIC_KEY_PEM=
# DEV_ALLOW_ANONYMOUS_AI=1